<launch>
  
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find UR5_project_10)/scripts/ambiente_simulazione.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <param name="robot_description" command="$(find xacro)/xacro '$(find open_manipulator_description)/urdf/open_manipulator_robot.urdf.xacro'"/>

  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" 
        args="-urdf -model open_manipulator -param robot_description -x 0.0 -y 0.0 -z 0.20" 
        output="screen" />
   
  <rosparam file="$(find open_manipulator_gazebo)/config/arm_controller.yaml" command="load"/>
  <rosparam file="$(find open_manipulator_gazebo)/config/gripper_controller.yaml" command="load"/>
  <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
        output="screen" args="joint1_position joint2_position joint3_position joint4_position gripper_position gripper_sub_position"/>

</launch>